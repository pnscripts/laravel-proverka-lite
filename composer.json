{
    "name": "pnscripts/laravel-proverka-lite",
    "description": "Bulgarian identifier validation for Laravel: EGN, LNCh, EIK/BULSTAT and VAT numbers with their real checksums, English and Bulgarian messages.",
    "type": "library",
    "license": "MIT",
    "keywords": ["laravel", "validation", "bulgaria", "egn", "lnch", "eik", "bulstat", "vat"],
    "homepage": "https://pnscripts.com/marketplace/laravel-proverka",
    "authors": [
        {"name": "PN Scripts", "email": "office@pnscripts.com", "homepage": "https://pnscripts.com"}
    ],
    "require": {
        "php": "^8.2",
        "illuminate/support": "^12.0|^13.0",
        "illuminate/validation": "^12.0|^13.0",
        "illuminate/translation": "^12.0|^13.0"
    },
    "require-dev": {
        "orchestra/testbench": "^10.0|^11.0",
        "phpunit/phpunit": "^11.5|^12.0"
    },
    "autoload": {"psr-4": {"PNScripts\\ProverkaLite\\": "src/"}},
    "autoload-dev": {"psr-4": {"PNScripts\\ProverkaLite\\Tests\\": "tests/"}},
    "extra": {"laravel": {"providers": ["PNScripts\\ProverkaLite\\ProverkaServiceProvider"]}},
    "config": {"sort-packages": true},
    "minimum-stability": "stable",
    "prefer-stable": true,
    "support": {
        "issues": "https://github.com/pnscripts/laravel-proverka-lite/issues",
        "source": "https://github.com/pnscripts/laravel-proverka-lite",
        "email": "office@pnscripts.com"
    }
}
